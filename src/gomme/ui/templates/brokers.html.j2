{% extends "base.html.j2" %}
{% import "macros.html.j2" as m with context %}
{% block title %}Brokers{% endblock %}
{% block content %}
<h1>Brokers</h1>
<p class="muted">Les entreprises connues pour collecter et revendre des données personnelles. Gomme écrit par défaut à celles de votre pays et aux internationales.</p>
<form method="get" action="/brokers" class="filters" role="search">
  <label class="visually-hidden" for="f-q">Rechercher</label>
  <input type="search" id="f-q" name="q" value="{{ query }}" placeholder="Rechercher un nom…">
  <label class="visually-hidden" for="f-region">Région</label>
  <select id="f-region" name="region"><option value="">Toutes les régions</option>{% for r in regions %}<option value="{{ r.value }}"{% if r.value == region %} selected{% endif %}>{{ region_labels[r] }}</option>{% endfor %}</select>
  <button class="btn">Filtrer</button>
</form>
<p class="small muted">{{ total }} broker{{ "s" if total > 1 else "" }}{% if total > brokers | length %}, {{ brokers | length }} affichés : affinez la recherche{% endif %}.</p>
<ul class="list">
  {% for b in brokers %}
  <li><a class="item" href="/brokers/{{ b.slug }}">
    <div class="main">
      <div class="title">{{ b.name }}</div>
      <div class="meta">{{ region_labels[b.region] }} · {{ category_labels[b.category] }} · {% for c in b.channels %}{{ channel_labels.get(c.type, c.type) }}{% if not loop.last %}, {% endif %}{% endfor %}</div>
    </div>
    <span class="chevron">{{ m.icon("chevron") }}</span>
  </a></li>
  {% endfor %}
</ul>
{% endblock %}
