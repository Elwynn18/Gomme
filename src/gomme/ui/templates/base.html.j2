{% import "macros.html.j2" as m with context -%}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{% block title %}Accueil{% endblock %} · Gomme</title>
<style>
{% include "style.css" %}
</style>
</head>
<body>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/">{{ m.logo() }}Gomme</a>
    {% block nav %}
    <nav class="nav" aria-label="Navigation principale">
      <a href="/"{% if path == "/" %} aria-current="page"{% endif %}>Accueil</a>
      <a href="/send"{% if path == "/send" %} aria-current="page"{% endif %}>À envoyer{% if to_send_count %} <span class="count">{{ to_send_count }}</span>{% endif %}</a>
      <a href="/brokers"{% if path.startswith("/brokers") %} aria-current="page"{% endif %}>Brokers</a>
      <a href="/profile"{% if path.startswith("/profile") %} aria-current="page"{% endif %}>Mon profil</a>
    </nav>
    {% endblock %}
    <span class="local" title="Gomme tourne sur votre ordinateur ; vos données n'en sortent pas.">{{ m.icon("lock") }}Sur votre ordinateur uniquement</span>
  </div>
</header>
<main{% block main_class %}{% endblock %}>
{% if message %}<div class="flash" role="status">{{ m.icon("check") }}<div>{{ message }}</div></div>{% endif %}
{% block content %}{% endblock %}
</main>
</body>
</html>
